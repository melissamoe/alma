<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ALMA 06{% endblock %}</title>
    <meta name="description" content="{% block description %}ALMA 06 informe, sensibilise et accompagne la prévention des situations de maltraitance envers les personnes âgées et les personnes en situation de handicap.{% endblock %}">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

<a href="#accueil" class="scroll-top">
    <svg viewBox="0 0 24 24" width="18" height="18">
        <path d="M12 5l-7 7h4v7h6v-7h4z" fill="white"/>
    </svg>
</a>

<header class="site-header">
    <div class="container site-header-inner">
        <a href="#accueil" class="logo">
            <img src="/images/logo1.png" alt="Logo ALMA 06" class="logo-img">
            <span>ALMA 06</span>
        </a>

        <nav class="site-nav" id="site-nav">
            <a href="#accueil">Accueil</a>
            <a href="#missions">Missions</a>
            <a href="#qui-sommes-nous">Qui sommes-nous ?</a>
            <a href="#centres">Nos centres</a>
            <a href="#contact">Contact</a>
        </nav>

        <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

<main>
    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container footer-newsletter-top">
        <div class="footer-newsletter-box">
            <div class="footer-newsletter-text">
                <span class="footer-newsletter-title">Newsletter</span>
                <h3>Inscrivez-vous à notre newsletter</h3>
                <p class="footer-newsletter-desc">
                    Recevez environ un message par mois pour suivre les actions menées par ALMA 06,
                    les sensibilisations réalisées et les projets en développement.
                </p>
            </div>

            <form action="/newsletter/subscribe" method="POST" id="newsletter-form-bottom" class="footer-newsletter-form">
                <label for="email-bottom" class="sr-only">Adresse email</label>
                <input type="email" id="email-bottom" name="email" placeholder="Votre adresse email" required>
                <button type="submit">S’inscrire</button>
            </form>

            <p id="form-message-bottom" class="form-message-bottom"></p>
        </div>
    </div>

    <div class="container footer-bottom">
        <p>© {{ "now"|date("Y") }} ALMA 06 - Tous droits réservés</p>
    </div>
</footer>

<script src="/assets/js/script.js"></script>
</body>
</html>